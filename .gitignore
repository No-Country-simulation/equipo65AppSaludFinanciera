# Raiz del repo. Por ahora se publica SOLO frontend/ (su .gitignore afina
# que entra alli). Lo demas queda local hasta que el equipo lo tome.

# --- Modulos que todavia no se publican ---
/infra/

# --- Doc interna / de trabajo (NO va al repo publico) ---
/CLAUDE.md
bd.md
perfil_financiero.sql
CAMBIOS_INTERFACES.md
CAMBIOS_BASE_DATOS.md
COMMITS_PENDIENTES.md
COMMITS_PROPUESTOS.md

# Doc de trabajo del equipo. Son utiles y estan vivas, pero NO se publican:
#   REVISION_API  -> valora el estado del codigo de companeros por su nombre
#   ENDPOINTS     -> inventario de lo que falta; en un repo publico se lee como
#                    un mapa de lo que la aplicacion todavia no protege
#   SINCRONIZACION-> acta de reunion, con nombres y decisiones internas
#   E2E_HALLAZGOS -> diagnostico de lo que esta roto, con el commit y el autor
#                    senalados; en un repo publico es un mapa de por donde
#                    entrar mientras no este arreglado
#   PROMPT_ARREGLOS-> el encargo para arreglarlo, derivado del anterior
# Se comparten por el canal del equipo, no por el repositorio.
/docs/REVISION_API.md
/docs/ENDPOINTS.md
/docs/SINCRONIZACION_*.md
/docs/E2E_HALLAZGOS.md
/docs/PROMPT_ARREGLOS.md

# Generado por Spring Initializr al crear el proyecto. No aporta nada y
# confunde: la doc real esta en README.md y docs/.
/HELP.md

# CHANGELOG.md SI se publica (es entregable del proyecto): no lo agregues aqui.

# /.idea/ va ENTERO fuera del repo (2026-08-19). Era configuracion local del IDE
# de cada persona -- workspace.xml solo ya llego a traer 48 lineas de diff en un
# push -- y ademas escondia una COPIA del backend Spring (pom.xml, mvnw, src/ con
# el paquete viejo com.hackathon.analisis) que duplicaba lo que vive en /backend/
# con el paquete bueno com.fintechvital.api. Nadie compilaba desde ahi.
/.idea/

# --- Secretos (defensa en profundidad; el detalle esta en frontend/.gitignore) ---
.env
*.env
.env.*
!.env.ejemplo
*.pem
*.key
*.p12
*.pfx
*.jks

# --- Dependencias y artefactos que nunca deben subir desde la raiz ---
node_modules/
dist/
build/
target/
__pycache__/
*.tsbuildinfo
# El APK de Android se construye, no se versiona: son ~110 MB por build.
*.apk
*.aab

# --- Herramientas de agentes / indexado local ---
.agents/
.codegraph/
# Solo lo local: `.claude/settings.json` (compartido) SI puede subir. Se listan
# los contenidos, no el directorio: git no reincluye archivos dentro de un
# directorio ya excluido.
.claude/*
!.claude/settings.json

# --- IDE / SO ---
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
desktop.ini

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/

# Artefactos de los tests E2E (frontend/e2e). El codigo de los tests SI se sube;
# los informes, trazas, videos y capturas de cada corrida no.
frontend/e2e/test-results/
frontend/e2e/informe/
frontend/e2e/playwright-report/
frontend/e2e/package-lock.json
