# =============================================================================
# Copia este archivo a ops/.env y ajusta lo que necesites.
#
#   Windows:      copy ops\.env.ejemplo ops\.env
#   Linux/macOS:  cp ops/.env.ejemplo ops/.env
#
# ops/.env NO se sube al repo (esta en .gitignore). El repo es PUBLICO: aqui no
# van contrasenas reales, ni de desarrollo.
# =============================================================================

# --- Aislamiento del entorno -------------------------------------------------
# Da nombre al proyecto de compose, a los contenedores y al volumen de datos.
# CADA ENTORNO NECESITA EL SUYO: con el mismo valor, levantar staging tumba el
# stack local y reutiliza su volumen (que se inicializo con otra contrasena, asi
# que la API ni siquiera puede conectarse).
#
#   .env          -> fintechvital
#   .env.staging  -> fintechvital-staging
#
# Cambiarlo equivale a empezar de cero: contenedores y volumen nuevos.
FV_PROYECTO=fintechvital

# --- Base de datos -----------------------------------------------------------
POSTGRES_DB=fintechvital
POSTGRES_USER=fintechvital
# Obligatoria: el compose se niega a arrancar si esta vacia.
# En local sirve cualquier cosa; en las instancias, una generada y guardada
# fuera del repo (OCI Vault / secretos de GitHub Actions).
POSTGRES_PASSWORD=cambia-esto-en-local

# Carga los 4 usuarios de ejemplo con 12 meses de movimientos.
#   si  -> desarrollo y grabacion de la demo
#   no  -> produccion y entrega (regla: CERO datos mock en la entrega)
# Solo tiene efecto en el PRIMER arranque, sobre un volumen vacio.
FV_CARGAR_DEMO=si

# Dataset del equipo (rama base-datos): 100 usuarios y 5.000 movimientos reales.
# Es independiente de FV_CARGAR_DEMO; se pueden activar los dos a la vez.
# Util para probar rendimiento y para que data science explore con volumen.
# En produccion: no.
FV_CARGAR_DATASET=si

# Contrasena de los 4 usuarios de ejemplo. Si se deja VACIA, las cuentas
# existen pero no se puede entrar con ellas.
# Solo aplica cuando FV_CARGAR_DEMO=si, o sea: nunca en produccion.
#
# ⚠️ SE QUEDA VACIA EN ESTE ARCHIVO, A PROPOSITO. Este .ejemplo SI se publica y
# el repositorio es PUBLICO. Un valor aqui es una credencial publicada: en el
# momento en que un entorno con estos usuarios quede accesible desde internet
# (el tunel de Cloudflare, por ejemplo), cualquiera entra con ella.
#
# Pon la tuya en tu ops/.env, que no se sube. Elige una distinta por entorno.
FV_PASSWORD_DEMO=

# --- API contra PostgreSQL ---------------------------------------------------
# La API se conecta a la base de datos real del contenedor `db`.
#
# ⚠️ SPRING_JPA_DDL=none es DELIBERADO. El esquema lo gobiernan las migraciones
# de db/, no Hibernate:
#   - "update"   -> Hibernate crearia SUS tablas (usuarios, banco_transacciones,
#                   categorias...) al lado de las reales, porque las entidades
#                   JPA todavia no coinciden con el modelo de datos.
#   - "validate" -> abortaria el arranque por esa misma discrepancia.
#   - "none"     -> se conecta y no toca nada. Es lo correcto hasta que las
#                   entidades se reconcilien con el esquema (docs/REVISION_API.md).
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fintechvital
SPRING_DATASOURCE_USERNAME=fintechvital
SPRING_DATASOURCE_PASSWORD=cambia-esto-en-local
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_DDL=none

# --- Web ---------------------------------------------------------------------
# ⚠️ Se HORNEA EN EL BUILD de la imagen (es una NEXT_PUBLIC_*). Cambiarla exige
# rebuild: `ops/stack.ps1 rebuild`. Reiniciar el contenedor NO basta.
#
# Quien hace esta llamada es el NAVEGADOR del usuario, no el contenedor: por eso
# tiene que ser una URL que el navegador pueda resolver.
#   local    -> http://localhost:8080/api/v1
#   staging  -> https://api-staging.fintechvital.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# URL de descarga del APK de Android. Si se deja VACIA, la web no pinta el
# bloque de "descargar la app": es lo correcto mientras el APK no este subido a
# ningun sitio, porque un boton que lleva a un 404 es peor que no ofrecerlo.
# Se hornea en el BUILD de la web (como NEXT_PUBLIC_API_URL): cambiarla exige
# rebuild, no basta con reiniciar el contenedor.
# Ejemplo con OCI Object Storage:
#   NEXT_PUBLIC_APK_URL=https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o/fintech-vital-1.0.0.apk
NEXT_PUBLIC_APK_URL=

# --- Tasas de cambio (perfil "tasas") ----------------------------------------
# Clave de https://www.exchangerate-api.com (el plan gratuito da 1500
# consultas al mes). /latest/USD trae TODAS las monedas de una vez, asi que
# refrescar cada 6 h son ~124 consultas al mes: un 8 % de la cuota.
# En el plan gratuito las tasas cambian UNA vez al dia, asi que 6 h ya es de
# sobra; si hiciera falta recortar, 43200 (12 h) o 86400 (24 h).
EXCHANGERATE_API_KEY=
FV_INTERVALO_TASAS=21600

# --- Cloudflare Tunnel (perfil "tunel") --------------------------------------
# Token del tunnel de Cloudflare. Es un SECRETO: quien lo tenga puede publicar
# lo que quiera bajo el dominio. Este archivo (.env) esta gitignoreado; el
# .env.ejemplo que estas leyendo NO debe llevar nunca el valor real.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Puertos publicados en la maquina ----------------------------------------
PUERTO_WEB=3000
PUERTO_API=8080
PUERTO_DB=5432
