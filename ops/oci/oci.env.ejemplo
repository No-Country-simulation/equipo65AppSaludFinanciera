# =============================================================================
# Datos de la cuenta de OCI y rutas locales que necesita el despliegue.
#
# Copia este archivo a `oci.env` (en este mismo directorio) y rellena los
# valores. `oci.env` NO entra al repositorio: lo excluye `*.env` del .gitignore.
#
#   cp ops/oci/oci.env.ejemplo ops/oci/oci.env
#
# Nada de aqui es un secreto por si solo -- los OCID son identificadores, no
# credenciales -- pero identifican tu tenancy, asi que tampoco hay motivo para
# publicarlos. Los secretos de verdad (la llave API, las llaves SSH) viven en
# archivos aparte, fuera del repositorio, y aqui solo se apunta a su carpeta.
# =============================================================================

# --- Identidad de la cuenta --------------------------------------------------
# Console > Perfil > My profile        -> OCID del usuario
OCI_USER_OCID=ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Console > Perfil > Tenancy           -> OCID de la tenancy
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Huella de la llave API (la que aparece al subir la publica en API Keys)
OCI_FINGERPRINT=00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff
OCI_REGION=mx-monterrey-1

# --- Carpeta con las credenciales (FUERA del repositorio) --------------------
# Tiene que contener:
#   oci/oci_api_key.pem   llave API (la usa oci-cli)
#   oci/bastion_rsa(.pub) llave RSA para la sesion del Bastion (RSA obligatorio)
#   oci/ssh_prod          llave para entrar a la instancia
OCI_LLAVES_DIR=C:\ruta\a\tus\llaves

# --- Instancia de destino ----------------------------------------------------
# La VM no tiene IP publica: se llega por el Bastion, que abre un forward local.
OCI_BASTION_OCID=ocid1.bastion.oc1.mx-monterrey-1.xxxxxxxxxxxxxxxxxxxxxxxxxx
# IP PRIVADA de la instancia dentro de la VCN (Console > Compute > Instancia).
# La de abajo es de ejemplo: pon la tuya.
OCI_INSTANCIA_IP=10.0.1.10
OCI_INSTANCIA_PUERTO_LOCAL=2202
OCI_INSTANCIA_USUARIO=ubuntu

# --- Registro de imagenes (OCIR) --------------------------------------------
# El namespace sale de: Console > Tenancy > Object Storage Namespace
OCIR_NAMESPACE=xxxxxxxxxxxx
OCIR_REPO=fintechvital
# Usuario de OCIR: <namespace>/Default/<tu-correo>  (o <namespace>/<correo> sin IdP)
OCIR_USUARIO=xxxxxxxxxxxx/Default/tu-correo@ejemplo.com

# --- Vault (opcional) --------------------------------------------------------
# Si esta puesto, el despliegue saca de ahi el token de OCIR y no hace falta
# tenerlo en ningun archivo. Si se deja vacio, se reutiliza el `podman login`
# que ya tenga hecho la instancia.
OCI_VAULT_OCID=
