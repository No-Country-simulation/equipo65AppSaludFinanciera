# Copia este archivo como .env.local (gitignoreado). Sin secretos: el repo es publico.

# Fuente de datos de las pantallas (ADR-0011): mock | api
# "mock" mientras no exista el backend; "api" al integrar (y se borra src/data/mock/)
NEXT_PUBLIC_DATA_SOURCE=mock

# URL de la API publica (solo aplica con DATA_SOURCE=api)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
