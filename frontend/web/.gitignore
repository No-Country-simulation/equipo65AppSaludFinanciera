# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla SI se publica: sin ella nadie sabe que variables hacen falta.
# (Este .gitignore es mas especifico que el de frontend/, asi que hay que repetir
#  la excepcion aqui o `.env*` se la come.)
!.env.ejemplo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agentes / indexado local
.claude/settings.local.json
.codegraph/

# OS
Thumbs.db
desktop.ini
